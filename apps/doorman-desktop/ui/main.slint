import { ScrollView } from "std-widgets.slint";

export struct RouteItem {
    name: string,
    url: string,
    target: string,
    port: int,
    project: string,
    pid: string,
    created: string,
    healthy: bool,
    command: string,
    // Group header row when non-empty (the repository name); other fields unused.
    header: string,
    header-count: int,
    // Git checkout, empty when the route wasn't started inside git.
    repo: string,
    branch: string,
    linked: bool,
    base-name: string,
    worktree: string,
    worktree-path: string,
    requests: int,
    errors: int,
    last-seen: string,
    avg-latency: string,
}

export struct TunnelLogItem {
    time: string,
    level: string,
    route: string,
    provider: string,
    message: string,
    raw: string,
}

export struct DomainItem {
    name: string,
    builtin: bool,
    // ready | setup | conflict
    status: string,
}

export struct TrafficItem {
    id: int,
    route: string,
    // Route name without a worktree's branch prefix, and that branch.
    route-label: string,
    branch: string,
    host: string,
    method: string,
    path: string,
    url: string,
    status: int,
    duration: string,
    size: string,
    request-size: string,
    response-size: string,
    time: string,
    full-time: string,
    curl: string,
}

global Theme {
    out property <color> bg: #0a0a0a;
    out property <color> surface: #111111;
    out property <color> raised: #171717;
    out property <color> border: #232323;
    out property <color> border-subtle: #1a1a1a;
    out property <color> border-strong: #333333;
    out property <color> row-hover: #141414;
    out property <color> row-selected: #1b1a24;
    out property <color> text: #ededed;
    out property <color> text-secondary: #a1a1a1;
    out property <color> text-tertiary: #6b6b6b;
    out property <color> accent: #8e7cf8;
    out property <color> accent-soft: #221f38;
    out property <color> green: #3ecf8e;
    out property <color> blue: #52a8ff;
    out property <color> amber: #f5a524;
    out property <color> red: #ff6166;
    out property <string> mono: "Menlo";

    public pure function method-color(method: string) -> color {
        if method == "GET" { return self.blue; }
        if method == "POST" { return self.green; }
        if method == "PUT" || method == "PATCH" { return self.amber; }
        if method == "DELETE" { return self.red; }
        return self.text-secondary;
    }

    public pure function status-color(status: int) -> color {
        if status >= 500 { return self.red; }
        if status >= 400 { return self.amber; }
        if status >= 300 { return self.blue; }
        return self.green;
    }
}

